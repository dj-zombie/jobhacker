# Copy to .env (gitignored). Real environment variables win over this file.

# The SQLite database. Leave unset to use the default below.
# DATABASE_PATH=./data/jobhacker.db

# Source API keys. Leave blank to disable that source.
JSEARCH_API_KEY=
JOBSPIPE_API_KEY=
WORKABLE_API_KEY=
TEAMTAILOR_API_KEY=

# Brandfetch Logo CDN client id. The browser loads logos; leave blank for monograms.
# Never commit a value.
BRANDFETCH_CLIENT_ID=
