# Copy to .env (gitignored). Real environment variables win over this file.

# Needed for scoring and for writing application materials. Never commit a value.
ANTHROPIC_API_KEY=

# Where Chrome or Chromium is, if JobHacker doesn't find it in the usual install folders.
# JOBHACKER_CHROME_PATH=

# The SQLite database. Leave unset to use the default below.
# DATABASE_PATH=./data/jobhacker.db

# Source API keys. Leave blank to disable that source.
JSEARCH_API_KEY=
JOBSPIPE_API_KEY=
WORKABLE_API_KEY=
TEAMTAILOR_API_KEY=

# Brandfetch Logo CDN client id. The browser loads logos; leave blank for monograms.
# Never commit a value.
BRANDFETCH_CLIENT_ID=

# The public demo's own Brandfetch client id (J21, D165). Never the one above: visitors'
# browsers load the demo's logos with it. Leave blank for letters. Never commit a value.
DEMO_BRANDFETCH_CLIENT_ID=
