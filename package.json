{
  "name": "jobhacker",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p site && biome check . && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "shoot": "tsx scripts/shoot.ts",
    "palette": "tsx scripts/palette.ts",
    "demo:dev": "vite --config site/vite.config.ts",
    "demo:build": "vite build --config site/vite.config.ts",
    "demo:preview": "vite preview --config site/vite.config.ts",
    "demo:record": "tsx scripts/record-demo-fill.ts",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:migrate": "tsx src/cli/index.ts db:migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.22",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.38.4",
    "geist": "^1.8.2",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "motion": "^14.6.0",
    "next": "^15.1.6",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "playwright-core": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.19",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.30.2",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
